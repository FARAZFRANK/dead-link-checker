<?xml version="1.0"?>
<ruleset name="Frank Dead Link Checker">
	<description>WordPress Coding Standards ruleset for the Frank Dead Link Checker plugin.</description>

	<file>.</file>

	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/assets/*</exclude-pattern>
	<exclude-pattern>*/languages/*</exclude-pattern>

	<arg value="sp"/>
	<arg name="basepath" value="./"/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>

	<rule ref="WordPress-Extra">
		<exclude name="WordPress.Files.FileName"/>
		<!-- Main plugin file intentionally mixes the FRANKDLC_Plugin class with its FRANKDLC() singleton accessor, the standard WP plugin bootstrap pattern. -->
		<exclude name="Universal.Files.SeparateFunctionsFromOO"/>
		<!-- $default is a well-established WP core parameter name (e.g. get_option( $option, $default )); not confusable with the `default` keyword in context. -->
		<exclude name="Universal.NamingConventions.NoReservedKeywordParameterNames"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="frank-dead-link-checker"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="FRANKDLC"/>
			</property>
		</properties>
	</rule>

	<config name="minimum_supported_wp_version" value="5.8"/>
</ruleset>
